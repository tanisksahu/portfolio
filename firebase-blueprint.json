{
  "entities": {
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Submitted portfolio messages from potential employers and clients",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "subject": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "email",
        "message",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/contactMessages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ContactMessage"
      },
      "description": "Collection storing contact form submissions"
    }
  }
}
